{
  "spacing": {
    "$type": "dimension",
    "0": { "$value": "0px" },
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "20px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "10": { "$value": "40px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" }
  },
  "radius": {
    "$type": "dimension",
    "none": { "$value": "0px" },
    "sm": { "$value": "4px" },
    "md": { "$value": "8px" },
    "lg": { "$value": "12px" },
    "full": { "$value": "9999px" }
  },
  "size": {
    "$type": "dimension",
    "touch-target": {
      "$value": "44px",
      "$description": "Minimum interactive hit area"
    },
    "container-max": { "$value": "1280px" }
  },
  "z": {
    "$type": "number",
    "dropdown": { "$value": 1000 },
    "sticky": { "$value": 1100 },
    "modal": { "$value": 1300 },
    "toast": { "$value": 1400 }
  }
}
