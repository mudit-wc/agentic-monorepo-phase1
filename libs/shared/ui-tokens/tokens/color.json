{
  "color": {
    "$type": "color",
    "brand": {
      "primary": {
        "$value": "#0f62fe",
        "$description": "Primary brand / interactive"
      },
      "primary-hover": { "$value": "#0353e9" },
      "primary-active": { "$value": "#002d9c" },
      "secondary": { "$value": "#393939" }
    },
    "neutral": {
      "0": { "$value": "#ffffff" },
      "50": { "$value": "#f4f4f4" },
      "100": { "$value": "#e0e0e0" },
      "200": { "$value": "#c6c6c6" },
      "300": { "$value": "#a8a8a8" },
      "400": { "$value": "#8d8d8d" },
      "500": { "$value": "#6f6f6f" },
      "600": { "$value": "#525252" },
      "700": { "$value": "#393939" },
      "800": { "$value": "#262626" },
      "900": { "$value": "#161616" }
    },
    "status": {
      "success": { "$value": "#24a148" },
      "warning": { "$value": "#f1c21b" },
      "error": { "$value": "#da1e28" },
      "info": { "$value": "#0043ce" }
    },
    "text": {
      "primary": { "$value": "{color.neutral.900}" },
      "secondary": { "$value": "{color.neutral.600}" },
      "inverse": { "$value": "{color.neutral.0}" },
      "link": { "$value": "{color.brand.primary}" },
      "error": { "$value": "{color.status.error}" }
    },
    "surface": {
      "page": { "$value": "{color.neutral.0}" },
      "card": { "$value": "{color.neutral.50}" },
      "raised": { "$value": "{color.neutral.0}" },
      "inverse": { "$value": "{color.neutral.900}" }
    },
    "border": {
      "subtle": { "$value": "{color.neutral.100}" },
      "strong": { "$value": "{color.neutral.300}" },
      "focus": { "$value": "{color.brand.primary}" }
    }
  }
}
