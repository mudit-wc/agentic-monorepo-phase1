{
  "name": "tools-ado-audit-hook",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "tools/ado-audit-hook/src",
  "projectType": "application",
  "tags": ["scope:tools", "type:tool"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "tsc -p tools/ado-audit-hook/tsconfig.lib.json"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "func start",
        "cwd": "tools/ado-audit-hook"
      }
    },
    "test": {
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"]
    }
  }
}
